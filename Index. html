<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090b14">
<title>Dhanush AI</title>

<style>
* { box-sizing:border-box; }
body {
  margin:0;
  background:#090b14;
  color:#eef1ff;
  font-family:Arial,sans-serif;
}
header {
  padding:16px;
  display:flex;
  align-items:center;
  gap:12px;
  border-bottom:1px solid #252e46;
  background:#101626;
}
.orb {
  width:43px;height:43px;
  border-radius:50%;
  background:linear-gradient(135deg,#6d5dfc,#00c8ff);
  display:flex;align-items:center;justify-content:center;
  font-size:22px;
}
h1 { font-size:21px;margin:0; }
small { color:#9ba6c5; }
main { max-width:700px;margin:auto;padding:14px; }
.welcome { text-align:center;padding:24px 8px; }
.welcome h2 { font-size:27px;margin:8px; }
.welcome p { color:#a6b0cc; }
.card {
  background:#131b2d;
  border:1px solid #27334d;
  border-radius:16px;
  padding:14px;
  margin:12px 0;
}
.quick {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
button {
  border:1px solid #34415f;
  background:#1a2440;
  color:white;
  border-radius:12px;
  padding:13px;
  font-size:14px;
  cursor:pointer;
}
button:active { opacity:.7; }
.quick button { text-align:left; }
#chat {
  display:flex;
  flex-direction:column;
  gap:12px;
  padding-bottom:15px;
}
.msg {
  padding:13px;
  border-radius:15px;
  max-width:90%;
  white-space:pre-wrap;
  line-height:1.5;
}
.bot { background:#182239;align-self:flex-start; }
.user { background:#294a88;align-self:flex-end; }
#inputbar {
  position:sticky;
  bottom:0;
  background:#090b14;
  padding:10px 0 16px;
  display:flex;
  gap:8px;
}
#prompt {
  flex:1;min-width:0;
  background:#131b2d;
  border:1px solid #34415f;
  color:white;
  border-radius:25px;
  padding:14px;
  font-size:16px;
  outline:none;
}
#send { background:#4568ed;border:none; }
#mic { background:#1b2843; }
#status { text-align:center;color:#91a2c9;font-size:12px;padding:5px; }
.footer { text-align:center;color:#697795;font-size:12px;padding:14px; }
</style>
</head>

<body>
<header>
  <div class="orb">🤖</div>
  <div>
    <h1>Dhanush AI</h1>
    <small>Your personal assistant</small>
  </div>
</header>

<main>
  <section class="welcome" id="welcome">
    <div style="font-size:42px">✨</div>
    <h2>Hi, Dhanush!</h2>
    <p>What can I help you with today?</p>
  </section>

  <section class="quick" id="quick">
    <button onclick="quickAsk('Help me with CCTV installation')">📹 CCTV Installation</button>
    <button onclick="quickAsk('Help me with networking')">🌐 Networking</button>
    <button onclick="quickAsk('Teach me something new')">🧠 Learn something</button>
    <button onclick="quickAsk('Give me a daily motivation')">⚡ Motivation</button>
  </section>

  <section class="card">
    <div id="chat"></div>
    <div id="status">Ready to chat</div>
    <div id="inputbar">
      <button id="mic" onclick="voiceInput()">🎙️</button>
      <input id="prompt" placeholder="Message Dhanush AI..." autocomplete="off">
      <button id="send" onclick="sendMessage()">➤</button>
    </div>
  </section>

  <div class="footer">
    Dhanush AI • Your personal assistant
    <br><br>
    <button onclick="toggleVoice()" id="voiceToggle">🔊 Voice replies: ON</button>
    <button onclick="clearChat()">🗑 Clear chat</button>
  </div>
</main>

<script>
let voiceOn = true;

function addMessage(text, type) {
  const chat = document.getElementById("chat");
  const div = document.createElement("div");
  div.className = "msg " + type;
  div.textContent = text;
  chat.appendChild(div);
  chat.scrollIntoView({behavior:"smooth", block:"end"});
}

function speak(text) {
  if (!voiceOn || !("speechSynthesis" in window)) return;
  speechSynthesis.cancel();
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = "en-IN";
  utter.rate = 1;
  speechSynthesis.speak(utterance);
}

function replyTo(text) {
  const q = text.toLowerCase();
  if (q.includes("cctv") || q.includes("camera") || q.includes("dvr") || q.includes("nvr")) {
    return "I can help with CCTV basics! 📹\\n\\nCheck these first:\\n1. Power supply / PoE\\n2. Camera IP address\\n3. Network connectivity\\n4. Correct NVR channel settings\\n5. Recording and playback\\n\\nTell me your camera or recorder model for specific steps.";
  }
  if (q.includes("network") || q.includes("internet") || q.includes("router") || q.includes("ip address")) {
    return "Let's troubleshoot your network! 🌐\\n\\n1. Check cable connections.\\n2. Check router DHCP.\\n3. Confirm the device IP and gateway.\\n4. Try pinging the device.\\n5. Check if IP addresses conflict.\\n\\nTell me what device you're setting up.";
  }
  if (q.includes("learn") || q.includes("teach")) {
    return "Let's learn something new! 🧠\\n\\nToday's topic: IP addresses. An IP address is like a digital house address for a device on a network. It helps devices find and communicate with each other.\\n\\nAsk me for networking, aviation, electronics, or technology topics!";
  }
  if (q.includes("motivation")) {
    return "Every expert was once a beginner. 💪 Don't worry about how fast you progress—focus on learning something new every day. Your consistency will build your future.";
  }
  if (q.includes("hello") || q.includes("hi") || q.includes("hey")) {
    return "Hey! 👋 I'm Dhanush AI, your personal assistant. What would you like to do today?";
  }
  if (q.includes("your name") || q.includes("who are you")) {
    return "I'm Dhanush AI 🤖, your personal assistant prototype. I'm here to help with learning, troubleshooting, ideas and everyday tasks.";
  }
  return "I received your message! 😊 This first version works with basic built-in responses. The real AI brain is not connected yet. We'll connect an actual AI API in the next stage so I can answer a much wider range of questions.";
}

function sendMessage() {
  const input = document.getElementById("prompt");
  const text = input.value.trim();
  if (!text) return;
  document.getElementById("welcome").style.display = "none";
  document.getElementById("quick").style.display = "none";
  addMessage(text, "user");
  input.value = "";
  document.getElementById("status").textContent = "Thinking...";
  setTimeout(() => {
    const answer = replyTo(text);
    addMessage(answer, "bot");
    document.getElementById("status").textContent = "Ready to chat";
    speak(answer);
  }, 400);
}

function quickAsk(text) {
  document.getElementById("prompt").value = text;
  sendMessage();
}

document.getElementById("prompt").addEventListener("keydown", function(e) {
  if (e.key === "Enter") sendMessage();
});

function voiceInput() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) {
    document.getElementById("status").textContent = "Voice input not supported in this browser. Try Chrome.";
    return;
  }
  const recognition = new SpeechRecognition();
  recognition.lang = "en-IN";
  recognition.interimResults = false;
  recognition.onstart = () => document.getElementById("status").textContent = "Listening... 🎙️";
  recognition.onresult = (event) => {
    document.getElementById("prompt").value = event.results[0][0].transcript;
    sendMessage();
  };
  recognition.onerror = () => document.getElementById("status").textContent = "Mic error. Check microphone permission.";
  recognition.onend = () => {
    if (document.getElementById("status").textContent === "Listening... 🎙️") {
      document.getElementById("status").textContent = "Ready to chat";
    }
  };
  recognition.start();
}

function toggleVoice() {
  voiceOn = !voiceOn;
  document.getElementById("voiceToggle").textContent =
    voiceOn ? "🔊 Voice replies: ON" : "🔇 Voice replies: OFF";
  if (!voiceOn) speechSynthesis.cancel();
}

function clearChat() {
  document.getElementById("chat").innerHTML = "";
  document.getElementById("welcome").style.display = "";
  document.getElementById("quick").style.display = "";
  document.getElementById("status").textContent = "Ready to chat";
  speechSynthesis.cancel();
}
</script>
</body>
</html>

